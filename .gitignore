# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- Node / frontend ---
node_modules/
frontend/dist/
*.log

# --- Simulation run logs ---
data_gen.log

# --- Cloned third-party repo -------------------------------------------------
# external/price-collusion-detector is a separate git repository with its own
# history and owner. Committing it from here would create a gitlink with no
# .gitmodules entry, which clones as an empty broken directory. Clone it
# yourself instead (see README quick start), or wire it up as a real submodule.
external/

# --- Generated data ----------------------------------------------------------
# data/ is deliberately COMMITTED, not ignored: it lets anyone clone the repo and
# run the dashboard straight away instead of waiting ~8 min for the simulation.
# That includes data/price_series.csv (15.5 MB of raw price paths) by choice --
# regenerate any of it with `python -m sim.generate_dataset`.

# German fuel benchmark raw download (re-fetch with python -m bench.fuel_de download)
data/fuel_de_cache/
data/archive_cache/
data/pha_cache/
.env
